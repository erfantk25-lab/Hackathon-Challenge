# ── Database ───────────────────────────────────────────────────
DB_USER=hackathon_user
DB_PASSWORD=hackathon_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hackathon_db

# ── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Blocket (optional) ─────────────────────────────────────────
# Leave empty unless you need authenticated endpoints
BLOCKET_BEARER_TOKEN=

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SYNC_INTERVAL_SECONDS=30
DEMO_MODE=false