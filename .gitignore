# ──────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
postgres-data/
pgdata/


# ──────────────────────────────────────────────────────────────
# ML artifacts (often big and regeneratable)
# ──────────────────────────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
models/checkpoints/
mlruns/

# Sentence-transformers and other model caches
.cache/
~/.cache/torch/
sentence_transformers_cache/


# ──────────────────────────────────────────────────────────────
# Blocket exploration data
# ──────────────────────────────────────────────────────────────
# Sample data files can be useful for the team to share,
# but they grow large fast — commit a couple of examples,
# ignore the rest
scripts/sample_data/*.json
!scripts/sample_data/example_*.json
!scripts/sample_data/README.md


